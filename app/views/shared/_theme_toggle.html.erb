<button
  type="button"
  class="theme-toggle"
  data-action="theme#toggle"
  data-theme-target="toggle"
  aria-pressed="false"
  aria-label="Switch to dark mode"
>
  <svg
    data-theme-target="lightIcon"
    xmlns="http://www.w3.org/2000/svg"
    class="h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
  </svg>
  <svg
    data-theme-target="darkIcon"
    xmlns="http://www.w3.org/2000/svg"
    class="hidden h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"></path>
  </svg>
</button>
