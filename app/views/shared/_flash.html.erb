<% if (alert = flash[:alert]) %>
  <div role="alert" class="rounded-lg border border-error/30 bg-error/10 px-4 py-3 text-sm text-base-content" id="alert">
    <span><%= alert %></span>
  </div>
<% end %>
<% if (notice = flash[:notice]) %>
  <div role="status" class="rounded-lg border border-success/30 bg-success/10 px-4 py-3 text-sm text-base-content" id="notice">
    <span><%= notice %></span>
  </div>
<% end %>
