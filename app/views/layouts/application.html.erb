<!DOCTYPE html>
<html data-theme="ideabug">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} · Ideabug" : "Ideabug" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "shared/theme_bootstrap" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body
    class="app-shell min-h-screen"
    data-controller="theme"
    data-theme-light-value="ideabug"
    data-theme-dark-value="ideabug_dark"
  >
    <% if authenticated? %>
      <div class="drawer min-h-screen lg:drawer-open">
        <input id="app-navigation" type="checkbox" class="drawer-toggle">

        <div class="drawer-content flex min-h-screen min-w-0 flex-col">
          <header class="site-header lg:hidden">
            <div class="flex h-14 items-center justify-between px-4">
              <label for="app-navigation" class="btn btn-ghost btn-sm btn-square" aria-label="Open navigation">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
              </label>
              <%= link_to dashboard_path, class: "brand-link" do %>
                <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>Ideabug</span>
              <% end %>
              <%= render "shared/theme_toggle" %>
            </div>
          </header>

          <main class="flex flex-1 flex-col pb-10 pt-5 sm:pt-7">
            <% if flash[:notice].present? || flash[:alert].present? %>
              <div class="app-page mb-4">
                <%= render "shared/flash" %>
              </div>
            <% end %>
            <%= yield %>
          </main>

          <footer class="app-footer">
            <div class="app-page flex flex-wrap items-center justify-between gap-3 py-5 text-xs">
              <p>Feedback infrastructure you control.</p>
              <div class="flex items-center gap-4">
                <%= render "shared/theme_toggle" %>
                <a href="https://humadroid.io/" class="link link-hover" title="Humadroid">Made by Humadroid</a>
              </div>
            </div>
          </footer>
        </div>

        <div class="drawer-side z-40">
          <label for="app-navigation" aria-label="Close navigation" class="drawer-overlay"></label>
          <%= render "shared/app_navigation" %>
        </div>
      </div>
    <% else %>
      <div class="flex min-h-screen flex-col">
        <header class="site-header">
          <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-4 sm:px-6">
            <%= link_to root_path, class: "brand-link" do %>
              <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
              <span>Ideabug</span>
            <% end %>
            <%= render "shared/theme_toggle" %>
          </div>
        </header>
        <main class="flex flex-1 flex-col"><%= yield %></main>
      </div>
    <% end %>
  </body>
</html>
