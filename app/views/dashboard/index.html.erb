<% content_for :title, "Overview" %>
<% open_feedback = @stats[:tickets_by_status].sum { |(_classification, status), count| status.to_s == "completed" ? 0 : count } %>

<div class="app-page space-y-6">
  <%= section_header \
        title: "Product pulse",
        eyebrow: "Overview",
        meta_items: [
          "#{@stats[:contacts_active_24h]} active contacts today",
          "#{@stats[:votes_last_7d]} votes this week"
        ] do %>
    <%= link_to tickets_path, class: "btn btn-ghost btn-sm border border-base-300" do %>
      Review inbox <%= app_icon(:arrow, class_name: "h-3.5 w-3.5") %>
    <% end %>
    <%= link_to new_announcement_path, class: "btn btn-primary btn-sm" do %>
      <%= app_icon(:plus, class_name: "h-3.5 w-3.5") %> New announcement
    <% end %>
  <% end %>

  <section class="app-panel grid overflow-hidden sm:grid-cols-2 xl:grid-cols-4" aria-label="Workspace metrics">
    <div class="metric-card">
      <p class="metric-label">Open feedback</p>
      <p class="metric-value"><%= open_feedback %></p>
      <p class="metric-context">Needs triage or product action</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Known contacts</p>
      <p class="metric-value"><%= @stats[:contacts_total] %></p>
      <p class="metric-context"><%= @stats[:contacts_identified] %> identified · <%= @stats[:contacts_anonymous] %> anonymous</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Announcement reads</p>
      <p class="metric-value"><%= @stats[:reads_last_7d] %></p>
      <p class="metric-context">Across the last 7 days</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Published updates</p>
      <p class="metric-value"><%= @stats[:announcements_last_30d] %></p>
      <p class="metric-context">During the last 30 days</p>
    </div>
  </section>

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1.45fr)_minmax(20rem,0.75fr)]">
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="app-panel overflow-hidden">
        <header class="panel-heading">
          <div>
            <h2 class="panel-title">Most requested</h2>
            <p class="panel-description">Open feature requests ranked by customer demand.</p>
          </div>
          <%= link_to "View roadmap", timeline_tickets_path, class: "link link-hover text-xs font-medium text-primary" %>
        </header>

        <% if @top_features.empty? %>
          <div class="px-5 py-10 text-center text-sm text-base-content/50">No active feature requests yet.</div>
        <% else %>
          <ol class="divide-y divide-base-300">
            <% @top_features.each_with_index do |ticket, index| %>
              <li class="grid grid-cols-[2rem_minmax(0,1fr)_auto] items-center gap-3 px-5 py-3.5">
                <span class="text-xs font-semibold tabular-nums text-base-content/30"><%= format("%02d", index + 1) %></span>
                <div class="min-w-0">
                  <%= link_to ticket.title, ticket_path(ticket), class: "block truncate text-sm font-medium text-base-content hover:text-primary" %>
                  <p class="mt-0.5 text-xs text-base-content/45"><%= ticket.status.humanize %></p>
                </div>
                <span class="inline-flex min-w-9 items-center justify-center rounded-full border border-base-300 px-2 py-1 text-xs font-semibold tabular-nums"><%= ticket.votes_count %></span>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>

      <section class="app-panel overflow-hidden">
        <header class="panel-heading">
          <div>
            <h2 class="panel-title">Latest bug reports</h2>
            <p class="panel-description">Fresh context arriving from embedded products.</p>
          </div>
          <%= link_to "Open inbox", tickets_path(classification: "bug"), class: "link link-hover text-xs font-medium text-primary" %>
        </header>

        <% if @recent_bugs.empty? %>
          <div class="px-5 py-10 text-center text-sm text-base-content/50">No bug reports yet.</div>
        <% else %>
          <ul class="divide-y divide-base-300">
            <% @recent_bugs.each do |ticket| %>
              <li class="flex items-start gap-3 px-5 py-3.5">
                <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-error/10 text-error"><%= app_icon(:bug, class_name: "h-3.5 w-3.5") %></span>
                <div class="min-w-0 flex-1">
                  <%= link_to ticket.title, ticket_path(ticket), class: "block truncate text-sm font-medium text-base-content hover:text-primary" %>
                  <p class="mt-1 text-xs text-base-content/45"><%= time_ago_in_words(ticket.created_at) %> ago · <%= ticket.source %></p>
                </div>
                <span class="status-dot <%= "status-dot-progress" if ticket.in_progress_status? %> <%= "status-dot-completed" if ticket.completed_status? %>"><%= ticket.status.humanize %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    </div>

    <aside class="space-y-6">
      <section class="app-panel overflow-hidden">
        <header class="panel-heading">
          <div>
            <h2 class="panel-title">Announcement reach</h2>
            <p class="panel-description">Reads recorded over the last eight weeks.</p>
          </div>
          <span class="text-xs font-medium tabular-nums text-base-content/45"><%= @stats[:reads_last_7d] %> this week</span>
        </header>
        <div class="px-5 py-5 text-primary">
          <% if @reads_by_week.any? %>
            <%= sparkline_svg(@reads_by_week.map { |_, value| value }, width: 480, height: 88) %>
            <div class="mt-3 flex items-center justify-between text-[0.65rem] font-medium uppercase tracking-[0.12em] text-base-content/40">
              <span>8 weeks ago</span><span>This week</span>
            </div>
          <% else %>
            <div class="py-8 text-center text-sm text-base-content/50">Reads will appear after your first announcement.</div>
          <% end %>
        </div>
      </section>

      <section class="app-panel p-5">
        <p class="app-kicker">Close the loop</p>
        <h2 class="mt-2 text-base font-semibold tracking-tight">Turn customer signal into a visible decision.</h2>
        <ol class="mt-4 space-y-3 text-sm">
          <li class="flex items-center gap-3"><span class="grid h-6 w-6 place-items-center rounded-full bg-primary/10 text-[0.68rem] font-semibold text-primary">1</span><span>Review incoming feedback</span></li>
          <li class="flex items-center gap-3"><span class="grid h-6 w-6 place-items-center rounded-full bg-primary/10 text-[0.68rem] font-semibold text-primary">2</span><span>Move accepted ideas onto the roadmap</span></li>
          <li class="flex items-center gap-3"><span class="grid h-6 w-6 place-items-center rounded-full bg-primary/10 text-[0.68rem] font-semibold text-primary">3</span><span>Announce what shipped to the right audience</span></li>
        </ol>
      </section>
    </aside>
  </div>
</div>
