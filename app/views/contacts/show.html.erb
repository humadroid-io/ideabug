<% reads_count = @contact.announcement_reads.count %>
<% votes_count = @contact.ticket_votes.count %>
<% submissions_count = @contact.submitted_tickets.count %>
<% identity = @contact.identified? ? @contact.external_id : @contact.anonymous_id %>
<% payload = @contact.info_payload.to_h %>
<% display_name = (payload["name"].presence || payload["email"].presence || (@contact.identified? ? identity : "Anonymous contact")).to_s %>
<% content_for :title, display_name %>

<div class="app-page space-y-6">
  <%= section_header \
        title: display_name,
        eyebrow: "Audience context",
        meta_items: [
          (@contact.identified? ? "identified" : "anonymous"),
          "first seen #{time_ago_in_words(@contact.created_at)} ago",
          (@contact.last_seen_at ? "last seen #{time_ago_in_words(@contact.last_seen_at)} ago" : nil),
          (@contact.announcements_opted_out? ? "updates muted" : nil)
        ] do %>
    <%= link_to "Back", contacts_path, class: "btn btn-sm btn-ghost" %>
    <%= link_to "Delete", @contact, class: "btn btn-sm btn-ghost text-error", data: {turbo_method: :delete, turbo_confirm: "Delete this contact and their activity?"} %>
  <% end %>

  <section class="app-panel grid overflow-hidden sm:grid-cols-3" aria-label="Contact activity">
    <div class="metric-card"><p class="metric-label">Announcement reads</p><p class="metric-value"><%= reads_count %></p><p class="metric-context">Updates opened</p></div>
    <div class="metric-card"><p class="metric-label">Feature votes</p><p class="metric-value"><%= votes_count %></p><p class="metric-context">Demand signals</p></div>
    <div class="metric-card"><p class="metric-label">Submissions</p><p class="metric-value"><%= submissions_count %></p><p class="metric-context">Bugs and ideas sent</p></div>
  </section>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.35fr)_minmax(19rem,0.65fr)]">
    <div class="space-y-6">
      <section class="app-panel overflow-hidden">
        <header class="panel-heading"><div><h2 class="panel-title">Contact properties</h2><p class="panel-description">Context supplied by the host product in the signed identity payload.</p></div></header>
        <% if payload.present? %>
          <dl class="divide-y divide-base-300">
            <% payload.each do |key, value| %>
              <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
                <dt class="text-xs font-medium text-base-content/45"><%= key.to_s.humanize %></dt><dd class="break-all text-sm text-base-content/75"><%= value %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="px-5 py-10 text-center text-sm text-base-content/45">No contact properties have been received.</p>
        <% end %>
      </section>

      <section class="app-panel overflow-hidden">
        <header class="panel-heading"><div><h2 class="panel-title">Segment membership</h2><p class="panel-description">Used to decide which targeted announcements this contact receives.</p></div></header>
        <% if @contact.segments.any? %>
          <div class="space-y-4 p-5">
            <% @contact.segments.each do |segment| %>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <span class="w-32 shrink-0 font-mono text-xs font-semibold text-base-content/55"><%= segment.identifier %></span>
                <div class="flex flex-wrap gap-1.5"><% @contact.segment_values.where(segment: segment).each do |segment_value| %><span class="badge badge-ghost badge-sm"><%= segment_value.val %></span><% end %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="px-5 py-10 text-center text-sm text-base-content/45">No segment values assigned.</p>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <section class="app-card">
        <h2 class="panel-title">Identity</h2>
        <dl class="mt-4 space-y-4">
          <div><dt class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-base-content/35">External ID</dt><dd class="mt-1 break-all font-mono text-xs text-base-content/70"><%= @contact.external_id || "Not identified" %></dd></div>
          <div><dt class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-base-content/35">Anonymous ID</dt><dd class="mt-1 break-all font-mono text-xs text-base-content/70"><%= @contact.anonymous_id || "None" %></dd></div>
          <div><dt class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-base-content/35">Database record</dt><dd class="mt-1 font-mono text-xs text-base-content/70">#<%= @contact.id %></dd></div>
        </dl>
      </section>

      <% if @contact.segments_payload.present? && @contact.segments_payload.any? %>
        <details class="app-panel overflow-hidden">
          <summary class="cursor-pointer px-5 py-4 text-sm font-semibold">Raw segment payload</summary>
          <pre class="overflow-x-auto border-t border-base-300 bg-neutral p-4 text-xs text-neutral-content"><%= JSON.pretty_generate(@contact.segments_payload) %></pre>
        </details>
      <% end %>
    </aside>
  </div>
</div>
