<% content_for :title, "Contacts" %>

<div class="app-page space-y-5">
  <%= section_header \
        title: "Contacts",
        eyebrow: "Audience context",
        meta_items: [
          pluralize(@pagy&.count || @contacts.size, "contact"),
          "identities seen through the widget"
        ] %>

  <%= form_with url: contacts_path, method: :get, class: "filter-bar flex flex-wrap items-end gap-3", local: true do %>
    <div class="form-control min-w-[14rem] flex-1">
      <label class="label" for="q"><span class="label-text">Find a contact</span></label>
      <input id="q" type="search" name="q" value="<%= params[:q] %>" placeholder="External or anonymous ID" class="input input-bordered input-sm w-full">
    </div>
    <div class="form-control w-full sm:w-44">
      <label class="label" for="type"><span class="label-text">Identity</span></label>
      <select id="type" name="type" class="select select-bordered select-sm py-0">
        <option value="">All identities</option>
        <option value="identified" <%= "selected" if params[:type] == "identified" %>>Identified</option>
        <option value="anonymous" <%= "selected" if params[:type] == "anonymous" %>>Anonymous</option>
      </select>
    </div>
    <div class="form-control w-full sm:w-48">
      <label class="label" for="active"><span class="label-text">Activity</span></label>
      <select id="active" name="active" class="select select-bordered select-sm py-0">
        <option value="">Any activity</option>
        <option value="24h" <%= "selected" if params[:active] == "24h" %>>Seen in last 24h</option>
      </select>
    </div>
    <button type="submit" class="btn btn-sm btn-neutral">Apply</button>
    <% if params.values_at(:q, :type, :active).any?(&:present?) %><%= link_to "Clear", contacts_path, class: "btn btn-sm btn-ghost" %><% end %>
  <% end %>

  <% if @contacts.empty? %>
    <div class="app-empty-state">
      <span class="mx-auto mb-3 grid h-10 w-10 place-items-center rounded-xl bg-base-200 text-base-content/40"><%= app_icon(:contacts, class_name: "h-5 w-5") %></span>
      <p class="font-medium text-base-content/70">No contacts match these filters.</p>
      <p class="mt-1">Contacts appear after someone opens the embedded widget.</p>
    </div>
  <% else %>
    <div class="app-panel overflow-hidden">
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>Contact</th><th class="hidden md:table-cell">Identity</th><th class="hidden xl:table-cell">Context</th><th class="hidden md:table-cell">Last seen</th><th class="hidden lg:table-cell">First seen</th><th class="hidden sm:table-cell"><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
            <% @contacts.each do |contact| %>
              <% payload = contact.info_payload.to_h %>
              <% identity = contact.identified? ? contact.external_id : contact.anonymous_id %>
              <% display_name = (payload["name"].presence || payload["email"].presence || (contact.identified? ? contact.external_id : "Anonymous contact")).to_s %>
              <tr>
                <td class="min-w-0 md:min-w-[16rem]">
                  <div class="flex items-center gap-3">
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-[0.68rem] font-semibold uppercase text-primary"><%= display_name.first(2) %></span>
                    <div class="min-w-0">
                      <%= link_to display_name, contact, class: "block max-w-xs truncate text-sm font-medium hover:text-primary" %>
                      <p class="mt-0.5 max-w-xs truncate font-mono text-[0.68rem] text-base-content/40"><%= identity %></p>
                      <div class="mt-1.5 md:hidden"><span class="badge badge-sm <%= contact.identified? ? "badge-primary badge-outline" : "badge-ghost" %>"><%= contact.identified? ? "Identified" : "Anonymous" %></span></div>
                    </div>
                  </div>
                </td>
                <td class="hidden md:table-cell"><span class="badge badge-sm <%= contact.identified? ? "badge-primary badge-outline" : "badge-ghost" %>"><%= contact.identified? ? "Identified" : "Anonymous" %></span></td>
                <td class="hidden max-w-md xl:table-cell"><p class="truncate text-xs text-base-content/55"><%= readable_hash(payload.except("name", "email")) if payload.except("name", "email").present? %></p></td>
                <td class="hidden whitespace-nowrap text-xs text-base-content/50 md:table-cell"><%= contact.last_seen_at ? "#{time_ago_in_words(contact.last_seen_at)} ago" : "Never" %></td>
                <td class="hidden whitespace-nowrap text-xs text-base-content/50 lg:table-cell"><%= time_ago_in_words(contact.created_at) %> ago</td>
                <td class="hidden text-right sm:table-cell"><%= link_to "Open", contact, class: "link link-hover text-xs font-medium text-primary" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% if @pagy %><div class="flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
  <% end %>
</div>
