<div id="<%= dom_id ticket %>" class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(19rem,0.6fr)]">
  <div class="space-y-6">
    <section class="app-card">
      <div class="flex flex-wrap items-center gap-2">
        <%= classification_pill(ticket) %>
        <span class="status-dot <%= "status-dot-progress" if ticket.in_progress_status? %> <%= "status-dot-completed" if ticket.completed_status? %>"><%= ticket.status.titleize %></span>
        <% if ticket.public_on_roadmap? %><span class="badge badge-success badge-outline badge-sm">Public</span><% end %>
      </div>

      <div class="mt-6">
        <h2 class="app-kicker">Customer signal</h2>
        <% if ticket.description.present? %>
          <div class="mt-3 whitespace-pre-wrap text-[0.95rem] leading-7 text-base-content/80"><%= ticket.description %></div>
        <% else %>
          <p class="mt-3 text-sm italic text-base-content/45">No description was provided.</p>
        <% end %>
      </div>
    </section>

    <% if ticket.context.present? && ticket.context.any? %>
      <section class="app-panel overflow-hidden">
        <header class="panel-heading">
          <div><h2 class="panel-title">Submission context</h2><p class="panel-description">Captured by the widget when this report was sent.</p></div>
        </header>
        <dl class="divide-y divide-base-300">
          <% ticket.context.each do |key, value| %>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-4">
              <dt class="text-xs font-medium text-base-content/45"><%= key.humanize %></dt>
              <dd class="break-all font-mono text-xs leading-5 text-base-content/75"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>

    <% if ticket.feature_request? && ticket.public_on_roadmap? && ticket.votes_count.positive? %>
      <section class="app-panel overflow-hidden">
        <header class="panel-heading">
          <div><h2 class="panel-title">Customer demand</h2><p class="panel-description"><%= pluralize(ticket.votes_count, "contact") %> voted for this request.</p></div>
        </header>
        <ul class="flex flex-wrap gap-2 p-5">
          <% ticket.voters.limit(20).each do |voter| %>
            <li><%= link_to(voter.identified? ? voter.external_id : (voter.anonymous_id || "Anonymous"), voter, class: "badge badge-ghost max-w-xs truncate font-mono text-[0.68rem]") %></li>
          <% end %>
          <% if ticket.votes_count > 20 %><li class="badge badge-ghost">+<%= ticket.votes_count - 20 %> more</li><% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="app-card">
      <h2 class="panel-title">Roadmap state</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-base-content/50">Visibility</dt><dd class="font-medium"><%= ticket.public_on_roadmap? ? "Public" : "Internal" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-base-content/50">Target</dt><dd class="text-right font-medium"><%= ticket.scheduled_for ? l(ticket.scheduled_for.to_date, format: :long) : "Not scheduled" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-base-content/50">Shipped</dt><dd class="text-right font-medium"><%= ticket.shipped_at ? l(ticket.shipped_at.to_date, format: :long) : "Not shipped" %></dd></div>
        <% if ticket.feature_request? %><div class="flex justify-between gap-4 border-t border-base-300 pt-3"><dt class="text-base-content/50">Votes</dt><dd class="font-semibold tabular-nums"><%= ticket.votes_count %></dd></div><% end %>
      </dl>
    </section>

    <section class="app-card">
      <h2 class="panel-title">Submitted by</h2>
      <% if ticket.contact %>
        <div class="mt-4 flex items-start gap-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-semibold text-primary"><%= ticket.contact.identified? ? "ID" : "A" %></span>
          <div class="min-w-0">
            <%= link_to(ticket.contact.identified? ? ticket.contact.external_id : "Anonymous contact", ticket.contact, class: "block truncate text-sm font-medium hover:text-primary") %>
            <p class="mt-1 text-xs text-base-content/45"><%= ticket.contact.last_seen_at ? "Seen #{time_ago_in_words(ticket.contact.last_seen_at)} ago" : "No recent activity" %></p>
          </div>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-base-content/50">Created by an administrator.</p>
      <% end %>
    </section>

    <p class="px-1 text-xs text-base-content/40">Last updated <%= time_ago_in_words(ticket.updated_at) %> ago.</p>
  </aside>
</div>
