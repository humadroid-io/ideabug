<section class="app-panel flex min-h-[22rem] flex-col overflow-hidden">
  <header class="panel-heading">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="panel-title"><%= title %></h2>
        <span class="rounded-full bg-base-200 px-2 py-0.5 text-[0.68rem] font-semibold tabular-nums text-base-content/55"><%= tickets.size %></span>
      </div>
      <p class="panel-description"><%= note %></p>
    </div>
  </header>

  <% if tickets.empty? %>
    <div class="grid flex-1 place-items-center px-6 py-12 text-center text-sm text-base-content/45"><%= empty %></div>
  <% else %>
    <ul class="flex-1 space-y-2 bg-base-200/30 p-3">
      <% tickets.each do |ticket| %>
        <li class="rounded-lg border border-base-300 bg-base-100 p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <%= link_to ticket.title, ticket_path(ticket), class: "block text-sm font-medium leading-5 hover:text-primary" %>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <%= classification_pill(ticket) %>
                <% if ticket.feature_request? %><span class="text-xs font-medium tabular-nums text-base-content/50"><%= pluralize(ticket.votes_count, "vote") %></span><% end %>
              </div>
            </div>
            <%= link_to "Edit", edit_ticket_path(ticket), class: "link link-hover shrink-0 text-xs text-base-content/45" %>
          </div>

          <% if ticket.scheduled_for || ticket.shipped_at %>
            <p class="mt-3 text-xs text-base-content/45">
              <% if ticket.shipped_at %>Shipped <%= time_ago_in_words(ticket.shipped_at) %> ago<% elsif ticket.scheduled_for %>Target <%= l(ticket.scheduled_for.to_date, format: :long) %><% end %>
            </p>
          <% end %>

          <div class="mt-3 flex flex-wrap gap-1.5 border-t border-base-300 pt-3">
            <% unless ticket.in_progress_status? %>
              <%= button_to "Start", transition_ticket_path(ticket, to: "start"), method: :post, class: "btn btn-xs btn-ghost border border-base-300" %>
            <% end %>
            <% unless ticket.shipped_at %>
              <%= button_to "Mark shipped", transition_ticket_path(ticket, to: "ship"), method: :post, class: "btn btn-xs btn-primary btn-outline" %>
            <% end %>
            <% if ticket.shipped_at %>
              <%= button_to "Reopen", transition_ticket_path(ticket, to: "reopen"), method: :post, class: "btn btn-xs btn-ghost border border-base-300" %>
            <% end %>
            <% if ticket.scheduled_for && ticket.shipped_at.nil? %>
              <%= button_to "Unschedule", transition_ticket_path(ticket, to: "unschedule"), method: :post, class: "btn btn-xs btn-ghost" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
