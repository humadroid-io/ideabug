<% content_for :title, "Edit feedback" %>

<div class="app-page space-y-6">
  <%= section_header \
        title: "Edit feedback",
        eyebrow: "Feedback inbox",
        meta_items: ["ticket ##{@ticket.id}", @ticket.title] do %>
    <%= link_to "Back", @ticket, class: "btn btn-ghost btn-sm" %>
  <% end %>

  <%= render "form", ticket: @ticket %>
</div>
