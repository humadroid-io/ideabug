<% content_for :title, "Feedback inbox" %>

<div class="app-page space-y-5">
  <%= section_header \
        title: "Feedback inbox",
        eyebrow: "Listen",
        meta_items: [
          pluralize(@pagy&.count || @tickets.size, "submission"),
          "bugs, ideas, and internal tasks"
        ] do %>
    <%= link_to timeline_tickets_path, class: "btn btn-ghost btn-sm border border-base-300" do %>
      <%= app_icon(:roadmap, class_name: "h-3.5 w-3.5") %> Roadmap
    <% end %>
    <%= link_to new_ticket_path, class: "btn btn-primary btn-sm" do %>
      <%= app_icon(:plus, class_name: "h-3.5 w-3.5") %> Add feedback
    <% end %>
  <% end %>

  <%= form_with url: tickets_path, method: :get, class: "filter-bar flex flex-wrap items-end gap-3", local: true do %>
    <div class="form-control min-w-[14rem] flex-1">
      <label class="label" for="q"><span class="label-text">Search feedback</span></label>
      <input id="q" type="search" name="q" value="<%= params[:q] %>" placeholder="Title or description" class="input input-bordered input-sm w-full">
    </div>
    <div class="form-control w-full sm:w-44">
      <label class="label" for="classification"><span class="label-text">Type</span></label>
      <select id="classification" name="classification" class="select select-bordered select-sm py-0">
        <option value="">All types</option>
        <% Ticket.classifications.keys.each do |classification| %>
          <option value="<%= classification %>" <%= "selected" if params[:classification] == classification %>><%= classification.titleize %></option>
        <% end %>
      </select>
    </div>
    <div class="form-control w-full sm:w-40">
      <label class="label" for="status"><span class="label-text">Status</span></label>
      <select id="status" name="status" class="select select-bordered select-sm py-0">
        <option value="">All statuses</option>
        <% Ticket.statuses.keys.each do |status| %>
          <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status.titleize %></option>
        <% end %>
      </select>
    </div>
    <div class="form-control w-full sm:w-36">
      <label class="label" for="sort"><span class="label-text">Order</span></label>
      <select id="sort" name="sort" class="select select-bordered select-sm py-0">
        <option value="">Newest</option>
        <option value="votes" <%= "selected" if params[:sort] == "votes" %>>Most voted</option>
      </select>
    </div>
    <button type="submit" class="btn btn-sm btn-neutral">Apply</button>
    <% if params.values_at(:q, :classification, :status, :sort).any?(&:present?) %>
      <%= link_to "Clear", tickets_path, class: "btn btn-sm btn-ghost" %>
    <% end %>
  <% end %>

  <% if @tickets.empty? %>
    <div class="app-empty-state">
      <span class="mx-auto mb-3 grid h-10 w-10 place-items-center rounded-xl bg-base-200 text-base-content/40"><%= app_icon(:feedback, class_name: "h-5 w-5") %></span>
      <p class="font-medium text-base-content/70">No feedback matches these filters.</p>
      <p class="mt-1">Clear the filters or add a submission manually.</p>
    </div>
  <% else %>
    <div class="app-panel overflow-hidden">
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>Feedback</th>
              <th class="hidden md:table-cell">Type</th>
              <th class="hidden md:table-cell">Status</th>
              <th class="hidden text-right lg:table-cell">Demand</th>
              <th class="hidden lg:table-cell">Source</th>
              <th class="hidden xl:table-cell">Received</th>
              <th class="hidden sm:table-cell"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr>
                <td class="min-w-0 max-w-xl md:min-w-[18rem]">
                  <%= link_to ticket.title, ticket_path(ticket), class: "block font-medium leading-5 text-base-content hover:text-primary" %>
                  <% if ticket.description.present? %>
                    <p class="mt-1 truncate text-xs text-base-content/45"><%= ticket.description %></p>
                  <% end %>
                  <div class="mt-2 flex flex-wrap items-center gap-2 md:hidden">
                    <%= classification_pill(ticket) %>
                    <span class="status-dot <%= "status-dot-progress" if ticket.in_progress_status? %> <%= "status-dot-completed" if ticket.completed_status? %>"><%= ticket.status.titleize %></span>
                    <% if ticket.feature_request? %><span class="text-xs font-medium text-base-content/45"><%= pluralize(ticket.votes_count, "vote") %></span><% end %>
                  </div>
                </td>
                <td class="hidden md:table-cell"><%= classification_pill(ticket) %></td>
                <td class="hidden md:table-cell"><span class="status-dot <%= "status-dot-progress" if ticket.in_progress_status? %> <%= "status-dot-completed" if ticket.completed_status? %>"><%= ticket.status.titleize %></span></td>
                <td class="hidden text-right lg:table-cell">
                  <% if ticket.feature_request? %>
                    <span class="font-semibold tabular-nums"><%= ticket.votes_count %></span>
                    <span class="ml-1 text-xs text-base-content/40">votes</span>
                  <% else %>
                    <span class="text-base-content/25">—</span>
                  <% end %>
                </td>
                <td class="hidden lg:table-cell"><span class="rounded-md bg-base-200 px-2 py-1 text-[0.68rem] font-medium uppercase tracking-wide text-base-content/55"><%= ticket.source %></span></td>
                <td class="hidden whitespace-nowrap text-xs text-base-content/50 xl:table-cell" title="<%= ticket.created_at %>"><%= time_ago_in_words(ticket.created_at) %> ago</td>
                <td class="hidden text-right sm:table-cell"><%= link_to "Open", ticket_path(ticket), class: "link link-hover text-xs font-medium text-primary" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="flex justify-center"><%== pagy_nav(@pagy) %></div>
  <% end %>
</div>
