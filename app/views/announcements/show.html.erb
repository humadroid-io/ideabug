<% content_for :title, @announcement.title %>
<% scheduled = @announcement.published_at && @announcement.published_at > Time.current %>
<% reads_count = @announcement.announcement_reads.count %>

<div class="app-page space-y-6">
  <%= section_header \
        title: @announcement.title,
        eyebrow: "Announcements",
        meta_items: [
          "announcement ##{@announcement.id}",
          (scheduled ? "scheduled for #{@announcement.published_at.to_fs(:long)}" : "published #{time_ago_in_words(@announcement.published_at)} ago"),
          (@announcement.segments.empty? ? "everyone" : pluralize(@announcement.segment_value_ids.size, "target value")),
          pluralize(reads_count, "read")
        ] do %>
    <%= link_to "Back", announcements_path, class: "btn btn-sm btn-ghost" %>
    <%= link_to "Edit", edit_announcement_path(@announcement), class: "btn btn-sm btn-primary" %>
    <%= link_to "Delete", @announcement, class: "btn btn-sm btn-ghost text-error", data: {turbo_method: :delete, turbo_confirm: "Delete this announcement?"} %>
  <% end %>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(19rem,0.6fr)]">
    <article class="app-card">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-sm <%= scheduled ? "badge-warning badge-outline" : "badge-success badge-outline" %>"><%= scheduled ? "Scheduled" : "Published" %></span>
        <span class="text-xs text-base-content/45"><%= l(@announcement.published_at, format: :long) %></span>
      </div>

      <% if @announcement.preview.present? %>
        <p class="mt-6 border-l-2 border-primary/50 pl-4 text-base leading-7 text-base-content/65"><%= @announcement.preview %></p>
      <% end %>

      <div class="public-prose mt-8 border-t border-base-300 pt-7"><%= @announcement.content %></div>
    </article>

    <aside class="space-y-4">
      <section class="app-card">
        <h2 class="panel-title">Delivery</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-base-content/50">Status</dt><dd class="font-medium"><%= scheduled ? "Scheduled" : "Live" %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-base-content/50">Reads</dt><dd class="font-semibold tabular-nums"><%= reads_count %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-base-content/50">Audience</dt><dd class="text-right font-medium"><%= @announcement.segments.empty? ? "Everyone" : "Targeted" %></dd></div>
        </dl>
      </section>

      <section class="app-card">
        <h2 class="panel-title">Audience rules</h2>
        <% if @announcement.segments.any? %>
          <div class="mt-4 space-y-4">
            <% @announcement.segments.each do |segment| %>
              <div>
                <p class="font-mono text-xs font-semibold text-base-content/55"><%= segment.identifier %></p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <% @announcement.segment_values.where(segment: segment).each do |segment_value| %><span class="badge badge-ghost badge-sm"><%= segment_value.val %></span><% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-base-content/50">No targeting rules. Every contact can receive this update.</p>
        <% end %>
      </section>

      <p class="px-1 text-xs text-base-content/40">Last edited <%= time_ago_in_words(@announcement.updated_at) %> ago.</p>
    </aside>
  </div>
</div>
