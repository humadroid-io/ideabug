<% content_for :title, "Announcements" %>

<div class="app-page space-y-5">
  <%= section_header \
        title: "Announcements",
        eyebrow: "Close the loop",
        meta_items: [
          pluralize(@pagy&.count || @announcements.size, "update"),
          "targeted in-product changelog"
        ] do %>
    <% if announcements_publicly_accessible? %>
      <%= link_to public_announcements_path, class: "btn btn-ghost btn-sm border border-base-300", target: "_blank", rel: "noopener" do %>
        Public changelog <%= app_icon(:external, class_name: "h-3.5 w-3.5") %>
      <% end %>
    <% end %>
    <%= link_to new_announcement_path, class: "btn btn-primary btn-sm" do %>
      <%= app_icon(:plus, class_name: "h-3.5 w-3.5") %> New announcement
    <% end %>
  <% end %>

  <%= form_with url: announcements_path, method: :get, class: "filter-bar flex flex-wrap items-end gap-3", local: true do %>
    <div class="form-control min-w-[14rem] flex-1">
      <label class="label" for="q"><span class="label-text">Search updates</span></label>
      <input id="q" type="search" name="q" value="<%= params[:q] %>" placeholder="Title or preview" class="input input-bordered input-sm w-full">
    </div>
    <div class="form-control w-full sm:w-48">
      <label class="label" for="scheduled"><span class="label-text">Publishing</span></label>
      <select id="scheduled" name="scheduled" class="select select-bordered select-sm py-0">
        <option value="">All dates</option>
        <option value="past" <%= "selected" if params[:scheduled] == "past" %>>Published</option>
        <option value="future" <%= "selected" if params[:scheduled] == "future" %>>Scheduled</option>
      </select>
    </div>
    <div class="form-control w-full sm:w-44">
      <label class="label" for="targeting"><span class="label-text">Audience</span></label>
      <select id="targeting" name="targeting" class="select select-bordered select-sm py-0">
        <option value="">All audiences</option>
        <option value="broadcast" <%= "selected" if params[:targeting] == "broadcast" %>>Everyone</option>
        <option value="targeted" <%= "selected" if params[:targeting] == "targeted" %>>Targeted</option>
      </select>
    </div>
    <button type="submit" class="btn btn-sm btn-neutral">Apply</button>
    <% if params.values_at(:q, :scheduled, :targeting).any?(&:present?) %><%= link_to "Clear", announcements_path, class: "btn btn-sm btn-ghost" %><% end %>
  <% end %>

  <% if @announcements.empty? %>
    <div class="app-empty-state">
      <span class="mx-auto mb-3 grid h-10 w-10 place-items-center rounded-xl bg-base-200 text-base-content/40"><%= app_icon(:announcements, class_name: "h-5 w-5") %></span>
      <p class="font-medium text-base-content/70">No announcements match these filters.</p>
      <p class="mt-1">Create an update when you are ready to close the customer feedback loop.</p>
    </div>
  <% else %>
    <section class="app-panel overflow-hidden">
      <ul class="divide-y divide-base-300">
        <% @announcements.each do |announcement| %>
          <% scheduled = announcement.published_at && announcement.published_at > Time.current %>
          <li class="group grid gap-4 px-5 py-5 transition-colors hover:bg-base-200/40 lg:grid-cols-[minmax(0,1fr)_12rem_9rem_auto] lg:items-center">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <%= link_to announcement.title, announcement, class: "truncate text-sm font-semibold text-base-content group-hover:text-primary" %>
                <span class="badge badge-sm <%= scheduled ? "badge-warning badge-outline" : "badge-success badge-outline" %>"><%= scheduled ? "Scheduled" : "Published" %></span>
              </div>
              <% if announcement.preview.present? %><p class="mt-1.5 line-clamp-2 max-w-3xl text-xs leading-5 text-base-content/50"><%= announcement.preview %></p><% end %>
            </div>

            <div>
              <p class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-base-content/35">Audience</p>
              <% if announcement.segments.any? %>
                <p class="mt-1 truncate text-xs font-medium text-base-content/65"><%= announcement.segments.first(2).map(&:identifier).join(", ") %><%= " +#{announcement.segments.size - 2}" if announcement.segments.size > 2 %></p>
              <% else %>
                <p class="mt-1 text-xs font-medium text-base-content/65">Everyone</p>
              <% end %>
            </div>

            <div>
              <p class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-base-content/35"><%= scheduled ? "Publishes" : "Published" %></p>
              <p class="mt-1 whitespace-nowrap text-xs font-medium text-base-content/65"><%= scheduled ? "in #{time_ago_in_words(announcement.published_at)}" : "#{time_ago_in_words(announcement.published_at)} ago" %></p>
            </div>

            <div class="flex items-center justify-end gap-1">
              <%= link_to "Open", announcement, class: "btn btn-ghost btn-xs" %>
              <%= link_to "Edit", edit_announcement_path(announcement), class: "btn btn-ghost btn-xs border border-base-300" %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <% if @pagy %><div class="flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
  <% end %>
</div>
