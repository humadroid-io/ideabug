<%= form_with(model: announcement) do |form| %>
  <% if announcement.errors.any? %>
    <div class="mb-5 rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm">
      <p class="font-semibold"><%= pluralize(announcement.errors.count, "problem") %> prevented this announcement from being saved.</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/70"><% announcement.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.5fr)_minmax(19rem,0.65fr)]">
    <section class="app-card space-y-5">
      <div>
        <h2 class="panel-title">Write the update</h2>
        <p class="panel-description">Lead with the outcome, then explain what changed and why it matters.</p>
      </div>
      <div class="form-control w-full">
        <%= form.label :title, class: "label pb-1.5 pt-0" %>
        <%= form.text_field :title, autofocus: announcement.new_record?, placeholder: "A clear, specific headline", class: "input input-bordered w-full" %>
      </div>
      <div class="form-control w-full">
        <%= form.label :preview, "Short preview", class: "label pb-1.5 pt-0" %>
        <%= form.text_area :preview, class: "textarea textarea-bordered w-full leading-6", rows: 3, placeholder: "One or two sentences shown in the widget feed…" %>
        <p class="mt-1.5 text-xs text-base-content/45">Keep this useful on its own; contacts see it before opening the full update.</p>
      </div>
      <div class="form-control w-full">
        <%= form.label :content, class: "label pb-1.5 pt-0" %>
        <%= form.rich_text_area :content %>
      </div>
    </section>

    <aside class="space-y-4">
      <section class="app-card space-y-4">
        <div>
          <h2 class="panel-title">Publishing</h2>
          <p class="panel-description">Publish now or choose a future time.</p>
        </div>
        <div class="form-control w-full">
          <%= form.label :published_at, "Publish at", class: "label pb-1.5 pt-0" %>
          <%= form.datetime_local_field :published_at,
                value: (announcement.published_at || Time.current).strftime("%Y-%m-%dT%H:%M"),
                class: "input input-bordered w-full" %>
        </div>
        <div class="rounded-lg border border-base-300 bg-base-200/45 p-3 text-xs leading-5 text-base-content/55">
          Future announcements remain hidden from contacts until their publish time.
        </div>
      </section>

      <section class="app-card">
        <h2 class="panel-title">Delivery</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4"><dt class="text-base-content/50">Channel</dt><dd class="font-medium">Embedded widget</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-base-content/50">Audience</dt><dd class="font-medium"><%= announcement.segment_value_ids.any? ? "Targeted" : "Everyone" %></dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-base-content/50">Read state</dt><dd class="font-medium">Tracked</dd></div>
        </dl>
      </section>
    </aside>
  </div>

  <fieldset class="app-fieldset mt-6">
    <legend class="px-2 text-sm font-semibold">Audience targeting</legend>
    <div class="mb-4 flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
      <p class="max-w-3xl text-sm leading-6 text-base-content/55">Leave every segment empty to reach everyone. Within each selected segment, a contact may match any selected value; across segments, they must match each one.</p>
      <span class="badge badge-outline badge-sm shrink-0"><%= announcement.segment_value_ids.any? ? pluralize(announcement.segment_value_ids.size, "value selected") : "Broadcast" %></span>
    </div>

    <div class="grid gap-3 lg:grid-cols-2">
      <% Segment.includes(:segment_values).find_each do |segment| %>
        <% values = segment.segment_values.to_a %>
        <% any_selected = values.any? { |value| announcement.segment_value_ids.include?(value.id) } %>
        <details class="app-panel group shadow-none" data-controller="segment-picker" <%= "open" if any_selected %>>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 select-none">
            <span class="flex min-w-0 items-center gap-2">
              <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              <span class="truncate font-mono text-sm font-semibold"><%= segment.identifier %></span>
            </span>
            <span class="badge badge-ghost badge-sm" data-segment-picker-target="count">0 / <%= values.size %></span>
          </summary>
          <div class="border-t border-base-300 px-4 pb-4 pt-3">
            <% if values.size > 8 %>
              <input type="search" placeholder="Filter values…" class="input input-bordered input-sm mb-3 w-full" data-segment-picker-target="filter" data-action="input->segment-picker#filter">
            <% end %>
            <% if values.empty? %>
              <p class="text-xs text-base-content/45">No values are defined for this segment.</p>
            <% else %>
              <div class="flex max-h-48 flex-wrap gap-2 overflow-y-auto">
                <% values.each do |segment_value| %>
                  <label data-segment-picker-target="value" class="flex cursor-pointer items-center gap-2 rounded-lg border border-base-300 px-2.5 py-1.5 text-xs hover:bg-base-200">
                    <%= check_box_tag "announcement[segment_value_ids][]", segment_value.id, announcement.segment_value_ids.include?(segment_value.id), id: "segment_value_#{segment_value.id}", class: "checkbox checkbox-xs", data: {segment_picker_target: "checkbox", action: "change->segment-picker#update"} %>
                    <span><%= segment_value.val %></span>
                  </label>
                <% end %>
              </div>
              <div class="mt-3 flex gap-3 text-xs">
                <button type="button" class="link link-primary" data-action="click->segment-picker#toggleAll" data-to-all="select">Select all</button>
                <button type="button" class="link link-hover" data-action="click->segment-picker#toggleAll" data-to-all="clear">Clear</button>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </fieldset>

  <div class="mt-6 flex justify-end gap-2">
    <%= link_to "Cancel", announcement.persisted? ? announcement : announcements_path, class: "btn btn-ghost" %>
    <%= form.submit(announcement.persisted? ? "Save announcement" : "Publish announcement", class: "btn btn-primary") %>
  </div>
<% end %>
