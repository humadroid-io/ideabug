<%= turbo_frame_tag "segment_value_#{f.object.id || f.object.fallback_id}-field" do %>
  <%= f.hidden_field :fallback_id %>
  <div id="<%= dom_id(f.object) %>" class="flex items-center gap-2 rounded-lg border border-base-300 bg-base-100 p-2">
    <%= f.text_field :val, placeholder: "Value", class: "input input-bordered input-sm min-w-0 flex-1" %>
    <%= link_to segment_value_path(f.object.id || f.object.fallback_id, idx: f.index), data: {turbo_method: :delete}, class: "btn btn-ghost btn-sm btn-square text-base-content/45 hover:text-error", aria: {label: "Remove value"} do %>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-9 0 1 15h8l1-15M10 10v7m4-7v7"></path></svg>
    <% end %>
  </div>
<% end %>
