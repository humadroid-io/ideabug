<%= form_with(model: segment) do |form| %>
  <% if segment.errors.any? %>
    <div class="mb-5 rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm">
      <p class="font-semibold"><%= pluralize(segment.errors.count, "problem") %> prevented this segment from being saved.</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/70"><% segment.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.25fr)_minmax(19rem,0.55fr)]">
    <section class="app-card space-y-5">
      <div><h2 class="panel-title">Segment definition</h2><p class="panel-description">Use the same key your host application sends in the signed segments payload.</p></div>
      <div class="form-control w-full">
        <%= form.label :identifier, class: "label pb-1.5 pt-0" %>
        <%= form.text_field :identifier, autofocus: segment.new_record?, placeholder: "plan", class: "input input-bordered w-full font-mono" %>
        <p class="mt-1.5 text-xs text-base-content/45">Saved in lowercase, for example <code class="rounded bg-base-200 px-1.5 py-0.5">plan</code> or <code class="rounded bg-base-200 px-1.5 py-0.5">company_size</code>.</p>
      </div>

      <div>
        <div class="mb-3 flex items-end justify-between gap-3"><div><h3 class="text-sm font-semibold">Allowed values</h3><p class="mt-1 text-xs text-base-content/45">Predefine values when the taxonomy should be controlled.</p></div></div>
        <fieldset class="space-y-2" id="segment_values">
          <%= form.fields_for :segment_values do |field| %><%= render "segment_values/form_field", f: field, fallback_id: SecureRandom.uuid %><% end %>
        </fieldset>
        <%= turbo_frame_tag "new_form_field" do %>
          <%= link_to segment_values_path, class: "btn btn-ghost btn-sm mt-3 border border-dashed border-base-300", data: {turbo_method: :post} do %><%= app_icon(:plus, class_name: "h-3.5 w-3.5") %> Add value<% end %>
        <% end %>
      </div>
    </section>

    <aside class="space-y-4">
      <section class="app-card">
        <h2 class="panel-title">Value policy</h2>
        <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-lg border border-base-300 bg-base-200/40 p-3">
          <%= form.check_box :allow_new_values, class: "checkbox checkbox-sm mt-0.5" %>
          <span><span class="block text-sm font-medium">Accept new values</span><span class="mt-1 block text-xs leading-5 text-base-content/50">Create values automatically when a signed contact payload contains one Ideabug has not seen before.</span></span>
        </label>
        <p class="mt-3 text-xs leading-5 text-base-content/45">Keep this off for fixed taxonomies such as paid plans. Turn it on for customer-defined data such as workspace or region.</p>
      </section>
      <div class="flex justify-end gap-2"><%= link_to "Cancel", segment.persisted? ? segment : segments_path, class: "btn btn-ghost" %><%= form.submit(segment.persisted? ? "Save segment" : "Create segment", class: "btn btn-primary") %></div>
    </aside>
  </div>
<% end %>
